# ==============================================================================
# THE MYSTERY CLICK - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Bu dosyadaki değerler opsiyoneldir. Boş bırakılırsa sistem otomatik olarak
# yüksek performanslı yerel motor ve JSON veri tabanında çalışır.
# Canlıya çıkarken ücretsiz Supabase ve Upstash linklerinizi buraya yazabilirsiniz.

# PORT (Varsayılan 3000)
PORT=3000

# 1. SUPABASE / POSTGRESQL VERİTABANI BAĞLANTISI (Ücretsiz: supabase.com)
# Örnek: postgresql://postgres.xxxx:sifreniz@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. UPSTASH / REDIS BAĞLANTISI (Ücretsiz: upstash.com)
# Örnek: rediss://default:sifreniz@eu1-xxxx.upstash.io:6379
REDIS_URL=
